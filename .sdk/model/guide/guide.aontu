# Shared paths need one rename map across all operations:
# attendee/webhook parents retain booking_id/event_type_id; existing items use id.
# Item keys are named id so generated CRUD flows can supply them.
# calendar_provider distinguishes the provider path from the calendarId query.
# Connection-scoped events use connection; provider routes are the default.
# Actions distinguish defaults, refreshes, subresources, and deprecated routes.
# Only documented data envelopes are unwrapped: OAuth2 tokens, status-only
# results, and redirects retain their base response transforms.

guide: entity: attendee: {
  id: composite: false
  path: "/v2/bookings/{bookingUid}/attendees": {
    rename: param: "bookingUid": "booking_id"
    op: create: method: "POST"
    op: create: transform: res: "`body.data`"
    op: list: method: "GET"
    op: list: transform: res: "`body.data`"
  }
  path: "/v2/bookings/{bookingUid}/attendees/{attendeeId}": {
    rename: param: "attendeeId": "id"
    rename: param: "bookingUid": "booking_id"
    op: load: method: "GET"
    op: load: transform: res: "`body.data`"
    op: remove: method: "DELETE"
    op: remove: transform: res: "`body.data`"
  }
}

