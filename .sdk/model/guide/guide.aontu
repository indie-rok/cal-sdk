# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"




# Cal.com wraps every response in { status, data }. The generator unwraps
# list responses on its own but not these loads, so the entity never held
# the record. Unwrap them by hand.
guide: entity: booking: path: "/v2/bookings/{bookingUid}": op: load: transform: res: "`body.data`"
guide: entity: schedule: path: "/v2/schedules/{scheduleId}": op: load: transform: res: "`body.data`"

# The generator split bookings across DTO-named entities. Fold confirm and
# decline back into booking as actions.
guide: entity: booking_output_2024_08_13: path: "/v2/bookings/{bookingUid}/confirm": active: false
guide: entity: booking_output_2024_08_13: path: "/v2/bookings/{bookingUid}/decline": active: false
guide: entity: booking: path: "/v2/bookings/{bookingUid}/confirm": {
  action: "confirm": {}
  rename: param: "bookingUid": "id"
  op: create: method: "POST"
}
guide: entity: booking: path: "/v2/bookings/{bookingUid}/decline": {
  action: "decline": {}
  rename: param: "bookingUid": "id"
  op: create: method: "POST"
}


