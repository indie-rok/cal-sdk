      h: "Are Calendar Events Enabled"
      n: "areCalendarEventsEnabled"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "If true and if managed user has calendar connected, calendar events will be created."
