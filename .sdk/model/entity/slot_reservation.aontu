      h: "Slot Duration"
      n: "slotDuration"
      op: {
        update: {
          req: true
          type: "`$NUMBER`"
        }
      }
      r: false
      sh: "By default slot duration is equal to event type length, but if you want to reserve a slot for an event type that has a variable length you can specify it here as a number in minutes."
      t: "`$NUMBER`"
    }
    slotEnd: {
      h: "Slot End"
      n: "slotEnd"
      r: true
      sh: "ISO 8601 datestring in UTC timezone representing slot end."
      t: "`$STRING`"
    }
    slotStart: {
      h: "Slot Start"
      n: "slotStart"
      r: true
      sh: "ISO 8601 datestring in UTC timezone representing available slot."
      t: "`$STRING`"
    }
