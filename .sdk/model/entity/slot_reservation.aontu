# Entity: slot_reservation

main: kit: entity: slot_reservation: {

  alias: field: {}

  fields: {
    eventTypeId: {
      h: "Event Type Id"
      n: "eventTypeId"
      r: true
      sh: "The ID of the event type for which slot should be reserved."
      t: "`$NUMBER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
