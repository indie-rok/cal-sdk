# BasicAttendeeFlow

main: kit: flow: BasicAttendeeFlow:
{
  entity: "attendee",
  kind: "basic",
  name: "BasicAttendeeFlow",
  step: [
    {
      i: {
        ref: "attendee_ref01"
      }

      m: {
        booking_id: "booking01"
      }

      o: "create"
    }

    {
      m: {
        booking_id: "booking01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "attendee_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "attendee_ref01",
        srcdatavar: "attendee_ref01_data",
        suffix: "_dt0"
      }

      m: {
        booking_id: "booking01",
        id: "attendee01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-attendee_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "attendee_ref01",
        suffix: "_rm0"
      }

      m: {
        booking_id: "booking01",
        id: "attendee01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        booking_id: "booking01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "attendee_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAttendeeFlow"
}