# BasicBookingFlow

main: kit: flow: BasicBookingFlow:
{
  entity: "booking",
  kind: "basic",
  name: "BasicBookingFlow",
  step: [
    {
      i: {
        ref: "booking_ref01"
      }

      m: {
        booking_id: "booking01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "booking_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "booking_ref01",
        srcdatavar: "booking_ref01_data",
        suffix: "_up0",
        textfield: "status"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-booking_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "booking_ref01",
        srcdatavar: "booking_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "booking01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-booking_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBookingFlow"
}